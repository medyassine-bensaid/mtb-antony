---
import OpenStatus from './OpenStatus.astro';
import { restaurant, dayOrder, dayLabels, frTime } from '../data/restaurant';
const a = restaurant.address;
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${restaurant.geo.lng - 0.006}%2C${restaurant.geo.lat - 0.003}%2C${restaurant.geo.lng + 0.006}%2C${restaurant.geo.lat + 0.003}&layer=mapnik&marker=${restaurant.geo.lat}%2C${restaurant.geo.lng}`;
---
<section id="infos" class="relative bg-coal-900 py-24 sm:py-32" aria-labelledby="info-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Horaires & accès</p>
    <h2 id="info-title" class="display mt-5 text-[clamp(3rem,9vw,6.5rem)]" data-reveal style="--d:1">
      Viens <span class="accent-serif text-amber">te mettre bien</span>
    </h2>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_1fr_1.2fr] lg:gap-10">
      <!-- Address & contact -->
      <div data-reveal>
        <h3 class="text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-cream/50">Adresse</h3>
        <address class="mt-4 not-italic">
          <span class="display block text-[2rem] leading-[1]">{a.street}</span>
          <span class="mt-2 block text-lg text-cream/75">{a.postalCode} {a.city}</span>
        </address>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={restaurant.links.directions} target="_blank" rel="noopener" class="btn btn-primary">Itinéraire <span class="sr-only">(Google Maps, nouvel onglet)</span></a>
          <a href={restaurant.phone.href} class="btn btn-ghost">{restaurant.phone.display}</a>
        </div>
        <h3 class="mt-10 text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-cream/50">Services</h3>
        <p class="mt-3 text-cream/80">{restaurant.services.join(' · ')}</p>
        <h3 class="mt-10 text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-cream/50">Suis-nous</h3>
        <a href={restaurant.links.instagram} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2.5 text-cream/85 hover:text-amber">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          {restaurant.links.instagramHandle}<span class="sr-only"> sur Instagram (nouvel onglet)</span>
        </a>
      </div>

      <!-- Hours -->
      <div data-reveal style="--d:1">
        <h3 class="text-[0.78rem] font-semibold uppercase tracking-[0.22em] text-cream/50">Horaires</h3>
        <OpenStatus class="mt-3 text-cream/85" />
        <table class="mt-4 w-full text-left">
          <caption class="sr-only">Horaires d’ouverture</caption>
          <tbody>
            {dayOrder.map((d) => (
              <tr data-day={d} class="hours-row border-b border-cream/10 last:border-b-0 data-[today=true]:text-amber">
                <th scope="row" class="py-3 font-medium">{dayLabels[d]}</th>
                <td class="py-3 text-right tabular-nums">
                  {restaurant.hours[d].length
                    ? restaurant.hours[d].map((s) => `${frTime(s.open)} – ${frTime(s.close)}`).join(', ')
                    : 'Fermé'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-4 text-sm text-cream/50">{restaurant.hoursNote} {restaurant.deliveryHoursNote}</p>
      </div>

      <!-- Map: loads OpenStreetMap only on request (no third-party request before consent) -->
      <div class="relative min-h-[20rem] overflow-hidden rounded-[2px] border border-cream/10 bg-coal-800" data-reveal style="--d:2">
        <div id="map-slot" class="absolute inset-0" data-src={osm}>
          <div class="flex h-full flex-col items-center justify-center gap-4 p-8 text-center">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#F4A940" stroke-width="1.8" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <p class="max-w-xs text-sm text-cream/60">La carte interactive est fournie par OpenStreetMap. Elle ne se charge que si tu la demandes.</p>
            <button type="button" id="map-load" class="btn btn-ghost">Afficher la carte</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
