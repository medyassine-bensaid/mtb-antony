---
import { url } from '../lib/url';
import { menu, menuMeta, formatPrice } from '../data/menu';
import { restaurant } from '../data/restaurant';

const checked = new Date(menuMeta.checkedOn).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<section id="carte" class="relative bg-coal-900 py-24 sm:py-32" aria-labelledby="menu-title">
  <div class="wrap">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="eyebrow" data-reveal>La carte</p>
        <h2 id="menu-title" class="display mt-5 text-[clamp(3.4rem,11vw,8rem)]" data-reveal style="--d:1">
          Tout est <span class="accent-serif text-amber">là.</span>
        </h2>
      </div>
      <p class="max-w-md text-cream/70" data-reveal style="--d:2">
        {menuMeta.menuIncludes} Sans inscription, sans appli : regarde, choisis, passe nous voir — ou commande en ligne.
      </p>
    </div>
  </div>

  <!-- Category chips: sticky, horizontally scrollable on mobile -->
  <nav
    id="menu-nav"
    aria-label="Catégories de la carte"
    class="sticky top-[var(--header-h)] z-30 mt-12 border-y border-cream/10 bg-coal-900/90 backdrop-blur-md"
  >
    <div class="wrap">
      <ul class="no-scrollbar relative -mx-4 flex gap-2 overflow-x-auto px-4 py-3 sm:mx-0 sm:px-0 [scrollbar-width:none]">
        {menu.map((c) => (
          <li class="shrink-0">
            <a
              href={`#cat-${c.id}`}
              data-cat={c.id}
              class="menu-chip inline-flex min-h-[2.75rem] items-center rounded-full border border-cream/15 px-4 text-[0.9rem] font-medium text-cream/75 transition-colors duration-300 hover:border-cream/50 hover:text-cream aria-[current=true]:border-amber aria-[current=true]:bg-amber aria-[current=true]:text-coal"
            >{c.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="wrap mt-6">
    {menu.map((cat, ci) => (
      <section id={`cat-${cat.id}`} data-menu-cat={cat.id} class="grid gap-6 border-b border-cream/10 py-14 last:border-b-0 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16" aria-labelledby={`h-${cat.id}`}>
        <header class="lg:sticky lg:top-[calc(var(--header-h)+6rem)] lg:self-start">
          <span class="font-serif text-xl italic text-amber">{String(ci + 1).padStart(2, '0')}</span>
          <h3 id={`h-${cat.id}`} class="display mt-2 text-[clamp(2.6rem,6vw,4rem)]" data-reveal>{cat.name}</h3>
          {cat.intro && <p class="mt-3 max-w-xs text-cream/60">{cat.intro}</p>}
        </header>

        <ul class="grid gap-x-12 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {cat.items.map((item, i) => (
            <li id={item.id} class="menu-item group relative border-b border-cream/[0.07] py-5 last:border-b-0" data-reveal style={`--d:${i % 4}`}>
              <div class="flex gap-4">
                {item.image && (
                  <img
                    src={url(`/images/menu/${item.image}-sm.webp`)}
                    alt={`${item.name}${item.imageIsMenu ? ' (photo du menu, avec frites et boisson)' : ''}`}
                    width="240" height="180" loading="lazy" decoding="async"
                    class="mt-1 h-[4.5rem] w-24 shrink-0 rounded-[3px] bg-amber object-cover sm:h-20 sm:w-[6.5rem]"
                  />
                )}
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline">
                    <h4 class="text-[1.15rem] font-semibold leading-snug">
                      {item.name}
                      {item.tags?.map((t) => (
                        <span class="ml-2 inline-block translate-y-[-2px] rounded-full border border-amber/40 px-2 py-0.5 align-middle text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-amber">{t}</span>
                      ))}
                    </h4>
                    {item.price !== undefined && (
                      <>
                        <span class="leader" aria-hidden="true"></span>
                        <span class="shrink-0 whitespace-nowrap font-display text-[1.45rem] tabular-nums text-amber">{formatPrice(item.price)}</span>
                      </>
                    )}
                  </div>
                  {item.description && <p class="mt-1.5 max-w-md text-[0.95rem] leading-relaxed text-cream/60">{item.description}</p>}
                  {item.priceNote && <p class="mt-2 text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-cream/45">{item.priceNote}</p>}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="mt-10 grid gap-6 rounded-[2px] border border-cream/10 p-6 text-[0.92rem] text-cream/60 sm:p-8 md:grid-cols-2">
      <p><strong class="text-cream/85">Prix.</strong> {menuMeta.priceDisclaimer} Carte à jour au {checked}.</p>
      <p><strong class="text-cream/85">Allergies.</strong> {menuMeta.allergenNote} Une question ? <a class="text-amber underline-offset-4 hover:underline" href={restaurant.phone.href}>{restaurant.phone.display}</a></p>
    </div>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .menu-item:target::before {
    content: '';
    position: absolute;
    inset: 0.25rem -0.75rem;
    border-radius: 4px;
    background: rgba(244, 169, 64, 0.1);
    animation: flash 2.4s ease-out forwards;
    pointer-events: none;
  }
  @keyframes flash { 0%, 50% { opacity: 1 } to { opacity: 0 } }
</style>
