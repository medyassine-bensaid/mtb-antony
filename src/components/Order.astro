---
import { restaurant } from '../data/restaurant';
const vouchers = restaurant.mealVouchersOnline.join(', ');
const options = [
  {
    n: '01', title: 'Par téléphone', text: 'Appelle, commande, passe récupérer. Le plus direct.',
    href: restaurant.phone.href, cta: restaurant.phone.display, external: false, primary: true,
  },
  {
    n: '02', title: 'Uber Eats', text: `Livraison ou retrait. Titres-restaurant acceptés sur l’appli (${vouchers}).`,
    href: restaurant.ordering.uberEats, cta: 'Commander sur Uber Eats', external: true, primary: false,
  },
  {
    n: '03', title: 'Deliveroo', text: 'Livraison ou retrait, avec la même carte qu’au restaurant.',
    href: restaurant.ordering.deliveroo, cta: 'Commander sur Deliveroo', external: true, primary: false,
  },
];
---
<section id="commander" class="relative py-24 sm:py-32" aria-labelledby="order-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Commander</p>
    <h2 id="order-title" class="display mt-5 max-w-4xl text-[clamp(3rem,9vw,6.5rem)]" data-reveal style="--d:1">
      Sur place, à emporter <span class="accent-serif text-amber">ou</span> livré
    </h2>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-[2px] bg-cream/10 lg:grid-cols-3">
      {options.map((o, i) => (
        <li class="group flex flex-col bg-coal p-7 transition-colors duration-500 hover:bg-coal-800 sm:p-9" data-reveal style={`--d:${i}`}>
          <span class="font-serif text-2xl italic text-amber">{o.n}</span>
          <h3 class="display mt-6 text-[2.6rem]">{o.title}</h3>
          <p class="mt-3 flex-1 text-cream/65">{o.text}</p>
          <a
            href={o.href}
            class:list={['btn mt-8 w-full', o.primary ? 'btn-primary' : 'btn-ghost']}
            {...(o.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {o.cta}
            {o.external && <span class="sr-only">(nouvel onglet)</span>}
            <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-cream/45">Les commandes en ligne sont gérées par Uber Eats et Deliveroo ; prix, frais et délais sont ceux affichés sur ces plateformes.</p>
  </div>
</section>
