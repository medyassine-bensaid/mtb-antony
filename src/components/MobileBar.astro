---
import { url } from '../lib/url';
import { restaurant } from '../data/restaurant';
---
<!-- Compact action bar for phones; appears after the hero, hides near the footer. -->
<nav
  id="mobile-bar"
  aria-label="Actions rapides"
  class="fixed inset-x-3 bottom-3 z-40 grid translate-y-[150%] grid-cols-3 gap-1 rounded-full border border-cream/10 bg-coal-800/90 p-1.5 shadow-2xl backdrop-blur-md transition-transform duration-500 [transition-timing-function:var(--ease-out)] data-[show=true]:translate-y-0 lg:hidden"
  style="padding-bottom: max(0.375rem, env(safe-area-inset-bottom));"
  data-show="false"
>
  <a href={restaurant.phone.href} class="flex min-h-[3rem] items-center justify-center gap-2 rounded-full bg-amber text-sm font-semibold text-coal">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    Appeler
  </a>
  <a href={restaurant.links.directions} target="_blank" rel="noopener" class="flex min-h-[3rem] items-center justify-center rounded-full text-sm font-semibold text-cream">Itinéraire</a>
  <a href={url('/#commander')} class="flex min-h-[3rem] items-center justify-center rounded-full text-sm font-semibold text-cream">Commander</a>
</nav>
