---
import { url } from '../lib/url';
import Storefront from './Storefront.astro';
import OpenStatus from './OpenStatus.astro';
import { restaurant } from '../data/restaurant';
import { photos } from '../data/photos';
import { menu, formatPrice } from '../data/menu';

const smashFrom = Math.min(...(menu.find((c) => c.id === 'smash')?.items.map((i) => i.price ?? Infinity) ?? [Infinity]));
const smashLabel = formatPrice(smashFrom).replace(/\s/g, '');
---
<section class="grain relative isolate overflow-hidden pt-[var(--header-h)]" aria-labelledby="hero-title">
  <!-- warm window light spilling on the page -->
  <div
    class="hero-glow pointer-events-none absolute -right-[20%] top-[-10%] -z-10 h-[90vmax] w-[90vmax] rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(closest-side, rgba(244,169,64,.45), rgba(226,70,43,.12) 55%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="wrap grid items-center gap-10 pb-14 pt-8 sm:pt-12 lg:min-h-[calc(100svh-var(--header-h))] lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pb-20">
    <div class="relative z-10">
      <p class="eyebrow rise !tracking-[0.16em] sm:!tracking-[0.22em]" style="--d:0">Antony · 209 av. de la Division Leclerc</p>

      <h1 id="hero-title" class="display mt-6 text-[clamp(3.6rem,18vw,9.5rem)]">
        <span class="rise-line"><span style="--d:1">Ici, on</span></span>
        <span class="rise-line"><span style="--d:2">se met</span></span>
        <span class="rise-line"><span style="--d:3" class="accent-serif text-amber text-[1.08em] leading-[0.8]">bien.</span></span>
      </h1>

      <p class="rise mt-7 max-w-[34rem] text-lg text-cream/80 sm:text-xl" style="--d:5">
        Smash burgers, sandwichs au pain maison et riz crousty.
        Sur place, à emporter ou livrés — tous les jours jusqu’à minuit.
      </p>

      <div class="rise mt-9 flex flex-wrap gap-3" style="--d:6">
        <a href="#carte" class="btn btn-primary">
          Découvrir la carte
          <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#infos" class="btn btn-ghost">Nous trouver</a>
      </div>

      <div class="rise mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-cream/10 pt-6 text-cream/75" style="--d:7">
        <OpenStatus />
        <a href={restaurant.links.googleReviews} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-[0.9rem] hover:text-cream">
          <span class="font-semibold text-cream">{restaurant.rating.value.toLocaleString('fr-FR')}/5</span>
          <span class="text-amber" aria-hidden="true">★★★★★</span>
          <span>{restaurant.rating.count} avis Google</span>
        </a>
      </div>
    </div>

    <figure class="relative mx-auto w-full max-w-[30rem] lg:max-w-none">
      <div class="rise relative aspect-[4/5] overflow-hidden rounded-[2px] shadow-[0_40px_120px_-30px_rgba(244,169,64,0.45)]" style="--d:3">
        <div class="hero-media h-full w-full scale-[1.06]">
          {photos.hero.src ? (
            <img
              src={url(photos.hero.src)}
              srcset={`${url(photos.hero.srcSm)} 640w, ${url(photos.hero.src)} 1200w`}
              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 30rem, 92vw"
              alt={photos.hero.alt}
              class="h-full w-full object-cover"
              width="1200"
              height="1500"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <Storefront class="h-full w-full" />
          )}
        </div>
      </div>
      <!-- price sticker -->
      <div class="rise absolute -left-3 bottom-10 grid h-28 w-28 rotate-[-10deg] place-items-center rounded-full bg-mustard text-center text-coal shadow-xl sm:-left-8 sm:h-32 sm:w-32" style="--d:8">
        <span class="leading-none">
          <span class="block text-[0.65rem] font-semibold uppercase tracking-[0.2em]">Smash dès</span>
          <span class="display block text-[2.3rem] sm:text-[2.6rem]">{smashLabel}</span>
        </span>
      </div>
      {!photos.hero.src && (
        <figcaption class="mt-3 text-right text-xs text-cream/40">Illustration</figcaption>
      )}
    </figure>
  </div>
</section>
