---
import { restaurant } from '../data/restaurant';
const r = restaurant.rating;
const checked = new Date(r.checkedOn).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<section class="relative border-y border-cream/10 bg-cream py-20 text-coal sm:py-28" aria-labelledby="reviews-title">
  <div class="wrap grid items-center gap-12 lg:grid-cols-[auto_1fr] lg:gap-24">
    <div class="flex items-end gap-5" data-reveal>
      <p class="display text-[clamp(7rem,22vw,13rem)] leading-[0.8]">{r.value.toLocaleString('fr-FR')}</p>
      <div class="pb-3">
        <p class="text-2xl tracking-[0.15em] text-ketchup" aria-hidden="true">★★★★★</p>
        <p class="mt-1 font-semibold">sur 5 · {r.count} avis {r.source}</p>
        <p class="text-sm text-coal/60">Relevé le {checked}</p>
      </div>
    </div>
    <div>
      <h2 id="reviews-title" class="display text-[clamp(2.4rem,6vw,4.2rem)]" data-reveal style="--d:1">
        Ce qui revient <span class="accent-serif text-ketchup">le plus</span> dans vos avis
      </h2>
      <ul class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:2">
        {restaurant.reviewThemes.map((t) => (
          <li class="rounded-full border border-coal/20 px-5 py-2.5 text-[0.95rem] font-medium first-letter:uppercase">{t}</li>
        ))}
      </ul>
      <a href={restaurant.links.googleReviews} target="_blank" rel="noopener" class="group mt-10 inline-flex items-center gap-2 font-semibold underline decoration-coal/30 underline-offset-[6px] hover:decoration-coal" data-reveal style="--d:3">
        Lire tous les avis sur Google
        <svg class="transition-transform duration-500 group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
    </div>
  </div>
</section>
