---
export interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<article class="wrap max-w-3xl pb-24 pt-[calc(var(--header-h)+4rem)]">
  <p class="eyebrow">Informations</p>
  <h1 class="display mt-5 text-[clamp(3rem,10vw,5.5rem)]">{title}</h1>
  <p class="mt-4 text-sm text-cream/50">Mise à jour : {updated}</p>
  <div class="legal mt-12 space-y-10 text-cream/80">
    <slot />
  </div>
</article>
<style is:global>
  .legal h2 { font-family: Anton, Impact, sans-serif; text-transform: uppercase; font-size: 1.8rem; line-height: 1; color: #F4EBDD; margin-bottom: .9rem; }
  .legal p + p, .legal ul { margin-top: .75rem; }
  .legal ul { list-style: disc; padding-left: 1.25rem; }
  .legal a { color: #F4A940; text-decoration: underline; text-underline-offset: 4px; }
  .legal .todo { color: #F8C67A; font-style: italic; }
</style>
