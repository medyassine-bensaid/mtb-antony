---
import { menu, formatPrice } from '../data/menu';
import { url } from '../lib/url';

// Basis: Uber Eats "most liked" ranking (29/10/2026) for the first three;
// Le Triple MTB carries the restaurant's name. Photo = the menu version shown on Uber Eats.
const spotlight: Record<string, { kicker: string; photo: string; photoAlt: string }> = {
  'crousty-au-choix': {
    kicker: 'N° 1 des plus aimés sur Uber Eats',
    photo: 'crousty-au-choix',
    photoAlt: 'Riz crousty : riz, morceaux de poulet croustillant et sauce',
  },
  'smash-classique': {
    kicker: 'N° 2 des plus aimés sur Uber Eats',
    photo: 'smash-classique-menu',
    photoAlt: 'Smash Classique en menu, avec frites twister et canette',
  },
  'le-supreme': {
    kicker: 'N° 3 des plus aimés sur Uber Eats',
    photo: 'le-supreme',
    photoAlt: 'Sandwich Le Suprême en menu : escalope de poulet, sauce fromagère, frites et canette',
  },
  'le-triple-mtb': {
    kicker: 'Celui qui porte notre nom',
    photo: 'le-triple-mtb',
    photoAlt: 'Sandwich Le Triple MTB en menu : triple steak, œuf, bacon, cheddar, frites et canette',
  },
};
const all = menu.flatMap((c) => c.items.map((i) => ({ ...i, category: c.name })));
const items = Object.keys(spotlight)
  .map((id) => all.find((i) => i.id === id))
  .filter((i): i is (typeof all)[number] => Boolean(i));
---
<section id="incontournables" class="relative py-24 sm:py-32" aria-labelledby="feat-title">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="eyebrow" data-reveal>Les incontournables</p>
        <h2 id="feat-title" class="display mt-5 text-[clamp(3rem,9vw,6.5rem)]" data-reveal style="--d:1">
          Ceux qu’on <span class="accent-serif text-amber">recommande</span><br class="hidden sm:block" /> les yeux fermés
        </h2>
      </div>
      <p class="max-w-sm text-cream/65" data-reveal style="--d:2">
        Les trois plats les plus aimés sur notre page Uber Eats — et le sandwich qui porte notre nom.
      </p>
    </div>

    <ol class="mt-16 grid gap-x-8 gap-y-14 md:grid-cols-2">
      {items.map((item, i) => {
        const s = spotlight[item.id];
        return (
          <li class:list={['group', i % 2 === 1 && 'md:translate-y-16']}>
            <a href={`#${item.id}`} class="block">
              <div class="relative overflow-hidden rounded-[2px] bg-amber" data-reveal="mask" style={`--d:${i % 2}`}>
                <img
                  src={url(`/images/menu/${s.photo}.webp`)}
                  alt={s.photoAlt}
                  width="586"
                  height="440"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-[1.2s] [transition-timing-function:var(--ease-out)] group-hover:scale-[1.05]"
                />
                <span class="absolute left-4 top-3 font-serif text-4xl italic text-white drop-shadow-[0_2px_8px_rgba(0,0,0,.35)] sm:text-5xl">0{i + 1}</span>
              </div>
              <div class="mt-6 flex items-start justify-between gap-6" data-reveal style={`--d:${(i % 2) + 1}`}>
                <div>
                  <p class="text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-cream/50">{s.kicker}</p>
                  <h3 class="display mt-2 text-[clamp(2.4rem,5.5vw,3.8rem)] transition-colors duration-500 group-hover:text-amber">{item.name}</h3>
                  {item.description && <p class="mt-2 max-w-md text-cream/70">{item.description}</p>}
                </div>
                <div class="shrink-0 text-right">
                  <p class="display text-[2.2rem] text-cream">{formatPrice(item.price)}</p>
                  {item.priceNote && <p class="text-sm text-cream/55">{item.priceNote}</p>}
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</section>
